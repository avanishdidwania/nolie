@startuml NoLie Architecture

title NoLie — Layer Architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor #191919
skinparam defaultFontColor #e0e0e0
skinparam ArrowColor #7a9ec7
skinparam componentBackgroundColor #222222
skinparam componentBorderColor #2e2e2e
skinparam noteBackgroundColor #2a2a2a
skinparam noteBorderColor #3a3a3a
skinparam packageBackgroundColor #1a1a1a
skinparam packageBorderColor #2e2e2e

package "PRESENTATION LAYER" {
  component [Popup\n- Scan button\n- Live (Captions)\n- Live (Audio)] as popup
  component [Side Panel\n- Results tab\n- Live tab\n- History tab\n- Export] as sidepanel
  component [Options Page\n- API keys\n- Custom prompt\n- Cross-verify toggle] as options
}

package "ORCHESTRATION LAYER" {
  component [Service Worker\n- Message router\n- Pipeline orchestrator\n- Tab capture initiator\n- Offscreen lifecycle\n- Live queue processor\n- RAG cache coordinator\n- History manager] as sw
}

package "CONTENT LAYER" {
  component [content.js\n- DOM extraction\n- Heatmap overlay] as content
  component [youtube.js\n- Transcript extraction] as youtube
  component [live-factcheck.js\n- Caption polling] as livecaption
}

package "OFFSCREEN LAYER" {
  component [offscreen.js\n- Tab audio capture\n- WebSocket to Deepgram\n- Audio passthrough] as offscreen
}

package "AI LAYER" {
  component [groq.js\n- Claim extraction\n- Claim verification\n- Cross-verification\n- Live claim detection] as groq
  component [gemini.js\n- Image analysis\n- Video thumbnail analysis] as gemini
  component [rag.js\n- Embed claims\n- Search cache\n- Store verified claims] as rag
}

package "DATA LAYER" {
  database [mbfc.json\n3,920 domains\nBias + Factual ratings] as mbfc
  database [chrome.storage\n- API keys\n- History\n- Settings] as storage
}

package "EXTERNAL SERVICES" {
  cloud [Groq API\nLlama 3.3 70B] as groqapi
  cloud [Google Gemini\n3.6 Flash] as geminiapi
  cloud [Gemini Embedding\ngemini-embedding-001\n768 dimensions] as embedapi
  cloud [Deepgram\nNova-2\n(WebSocket)] as deepgramapi
  cloud [Supabase\npgvector\n(RAG Cache)] as supabase
  cloud [Vercel Backend\nToken issuance] as backend
}

' Presentation to Orchestration
popup --> sw : SCAN_PAGE\nSTART_LIVE
sidepanel --> sw : STOP_LIVE\nGET_HISTORY
options --> storage : save settings

' Orchestration to Content
sw --> content : EXTRACT_CONTENT
sw --> youtube : executeScript\n(world: MAIN)
sw --> livecaption : START_LIVE

' Orchestration to Offscreen
sw --> offscreen : START_CAPTURE\n(streamId)

' Orchestration to AI
sw --> groq : extract + verify
sw --> gemini : analyze images
sw --> rag : check cache\nstore results

' Orchestration to Data
sw --> mbfc : domain lookup
sw --> storage : save history

' Content back to Orchestration
content --> sw : page content
livecaption --> sw : LIVE_BATCH
youtube --> sw : transcript text

' Offscreen back to Orchestration
offscreen --> sw : TRANSCRIPT_FINAL\nTRANSCRIPT_INTERIM

' Orchestration to Presentation
sw --> sidepanel : SCAN_COMPLETE\nLIVE_CLAIMS\nLIVE_TRANSCRIPT

' AI Layer to External
groq --> groqapi : REST API\n(JSON)
gemini --> geminiapi : REST API\n(multimodal)
rag --> embedapi : embed claim\n(768-dim vector)
rag --> supabase : search similar\nstore verified

' Offscreen to External
offscreen --> deepgramapi : WebSocket\n(Int16 PCM audio)
deepgramapi --> offscreen : WebSocket\n(transcription JSON)
offscreen --> backend : fetch token

' Content to Web Pages
component [Web Pages] as pages
content --> pages

note right of supabase
  Self-learning cache
  Stores cross-verified
  HIGH confidence claims
  Similarity threshold: 0.92
end note

note right of deepgramapi
  Bidirectional WebSocket
  Client sends: raw audio
  Server sends: transcript
end note

note bottom of sw
  Central coordinator
  RAG check before Groq
  Only stores after cross-verify
end note

@enduml
