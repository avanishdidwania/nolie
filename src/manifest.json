{
  "manifest_version": 3,
  "name": "NoLie - AI Fact Checker",
  "description": "AI-powered content credibility and fact verification. Auto-scan articles, verify claims, analyze images, and assess source reliability.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*",
    "https://api.deepgram.com/*",
    "wss://api.deepgram.com/*",
    "https://nolie-backend.vercel.app/*",
    "https://vvgforamjjqsthwwbeyw.supabase.co/*",
    "https://nolie-agent-production.up.railway.app/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "src/assets/logo.svg"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "css": ["src/content/heatmap.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "scan-page": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Scan current page for fact checking"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/offscreen/offscreen.html", "src/offscreen/offscreen.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
